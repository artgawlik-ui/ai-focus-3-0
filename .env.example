# Set actual secrets in Render Environment; never commit them.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./focus3.db
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Menedżer
# Optional paid integration; requires explicit activation approval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Offsite encrypted backup / restore verification:
BACKUP_PASSPHRASE=
RESTORE_DATABASE_URL=

# Pause all worker stages; default false preserves existing behavior.
# Empty/invalid values pause fail-closed. Production change requires approval.
WORKER_PAUSED=false

# Optional public OSM radius search; activation on production requires approval.
DISCOVERY_RADIUS_ENABLED=false
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search

# Local day/week/rescheduling UI, no Google OAuth or external writes.
VISIT_PLANNER_ENABLED=false

# Separate optional schema 005, OAuth and outgoing writes; all OFF by default.
GOOGLE_SCHEMA_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_WRITE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ENCRYPTION_KEY=

# Natywny kalendarz Focus: opcjonalny profil006 na bazie004, domyślnie OFF.
FOCUS_CALENDAR_ENABLED=false
